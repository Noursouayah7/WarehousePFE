generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  blocId      Int
  description String?
  price       Float
  quantity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bloc        Bloc     @relation(fields: [blocId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  restockAlerts RestockAlert[]

  @@map("products")
}

model Warehouse {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  surface     Float    
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks      Bloc[]
  restockAlerts RestockAlert[]

  @@map("warehouses")
}
model Bloc {
  id           Int       @id @default(autoincrement())
  name         String
  capacity     Float     
  currentUsage Float     @default(0) // tracked usage, always <= capacity
  warehouseId  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  products     Product[]
  shipments    Shipment[]
  sourceInventoryMovements InventoryMovement[] @relation("InventoryMovementSourceBloc")
  destinationInventoryMovements InventoryMovement[] @relation("InventoryMovementDestinationBloc")
  restockAlerts RestockAlert[]

  @@map("blocs")
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  name             String?
  password         String
  address          String?
  phone            String?
  cin              String   @unique
  profilePicture   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  roles            UserRole @default(PENDING)

  orders           Order[]
  supportTickets   SupportTicket[]
  reclamations     Reclamation[]
  inventoryMovements InventoryMovement[] @relation("InventoryMovementTechnician")
  restockAlertsCreated RestockAlert[] @relation("RestockAlertManager")
  restockAlertsHandled RestockAlert[] @relation("RestockAlertTechnician")
}

model Order {
  id               Int            @id @default(autoincrement())
  customerId       Int?
  productName      String
  quantity         Int
  totalAmount      Float          @default(0)
  deliveryDeadline DateTime
  deliveryAddress  String
  customerName     String
  customerPhone    String
  status           OrderStatus    @default(PENDING)
  deliveryStatus   DeliveryStatus @default(PENDING)
  managerNote      String?
  rejectionReason  String?
  approvedAt       DateTime?
  deliveredAt      DateTime?
  restockAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer         User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shipments        Shipment[]
  items            OrderItem[]
  reclamations     Reclamation[]
  inventoryMovements InventoryMovement[]

  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  unitPrice   Float
  quantity    Int
  lineTotal   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Shipment {
  id             Int            @id @default(autoincrement())
  orderId        Int?
  type           ShipmentType   @default(RESTOCK)
  productName    String
  quantity       Int
  blocId         Int
  supplierName   String?
  trackingNumber String?
  expectedAt     DateTime?
  receivedAt     DateTime?
  status         ShipmentStatus @default(REQUESTED)
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  bloc           Bloc           @relation(fields: [blocId], references: [id], onDelete: Restrict)
  reclamations   Reclamation[]
  inventoryMovements InventoryMovement[]

  @@map("shipments")
}

model RestockAlert {
  id                Int                  @id @default(autoincrement())
  productId         Int?
  productName       String
  currentStock      Int
  requestedQuantity  Int
  warehouseId       Int
  blocId            Int
  priority          RestockPriority      @default(MEDIUM)
  managerNote       String?
  status            RestockAlertStatus    @default(PENDING)
  managerId         Int?
  technicianId      Int?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  product           Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  warehouse         Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  bloc              Bloc                 @relation(fields: [blocId], references: [id], onDelete: Restrict)
  manager           User?                @relation("RestockAlertManager", fields: [managerId], references: [id], onDelete: SetNull)
  technician        User?                @relation("RestockAlertTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]

  @@map("restock_alerts")
}

model InventoryMovement {
  id                Int                     @id @default(autoincrement())
  productId         Int?
  productName       String
  quantity          Int
  operationType     InventoryOperationType
  sourceBlocId      Int?
  destinationBlocId Int?
  orderId           Int?
  shipmentId        Int?
  restockAlertId    Int?
  technicianId      Int?
  note              String?
  createdAt         DateTime                @default(now())

  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  sourceBloc        Bloc?     @relation("InventoryMovementSourceBloc", fields: [sourceBlocId], references: [id], onDelete: SetNull)
  destinationBloc   Bloc?     @relation("InventoryMovementDestinationBloc", fields: [destinationBlocId], references: [id], onDelete: SetNull)
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment          Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  restockAlert      RestockAlert? @relation(fields: [restockAlertId], references: [id], onDelete: SetNull)
  technician        User?     @relation("InventoryMovementTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  @@map("inventory_movements")
}

model SupportTicket {
  id          Int                   @id @default(autoincrement())
  title       String
  category    SupportTicketCategory
  description String
  priority    SupportTicketPriority  @default(MEDIUM)
  status      SupportTicketStatus    @default(OPEN)
  managerNote String?
  createdById Int
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  createdBy   User                  @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model Reclamation {
  id              Int                     @id @default(autoincrement())
  customerId      Int
  orderId         Int?
  shipmentId      Int?
  problemType     ReclamationProblemType
  description     String
  attachmentUrl   String?
  status          ReclamationStatus       @default(PENDING)
  managerNote     String?
  resolvedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  customer        User                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order           Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment        Shipment?               @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@map("reclamations")
}

enum UserRole {
  ADMIN
  MANAGER
  TECHNICIEN
  CUSTOMER
  VISITOR
  PENDING
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  RESTOCK_REQUESTED
  COMPLETED
}

enum DeliveryStatus {
  PENDING
  IN_DELIVERY
  DELIVERED
}
enum ShipmentType {
  RESTOCK
  ORDER
}
enum ShipmentStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
}

enum RestockAlertStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum RestockPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportTicketCategory {
  MACHINE_MALFUNCTION
  PRODUCT_ISSUE
  DELAY
  ALERT
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InventoryOperationType {
  STOCK_IN
  STOCK_OUT
  TRANSFER
  DAMAGE
  RESTOCK
  RESTOCK_ALERT
  SHIPMENT_CREATED
  ORDER_APPROVED
}

enum ReclamationProblemType {
  PRODUCT_ISSUE
  SHIPMENT_ISSUE
  ORDER_ISSUE
}

enum ReclamationStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model PricePredictionLog {
  id           Int      @id @default(autoincrement())
  userId       Int?
  role         UserRole
  input        Json
  predictedPrice Float
  modelVersion String?
  createdAt    DateTime @default(now())

  @@map("price_prediction_logs")
}